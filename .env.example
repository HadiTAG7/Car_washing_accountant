# ═══════════════════════════════════════════════════════════════════════════
# Supabase configuration for Sweater (سويتر)
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to ".env.local" and fill in the values from
# your Supabase project: Project Settings → API
#
# If these are missing, the app still runs in DEMO MODE using seed data
# (useful for UI previews without a live database).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional — login is REQUIRED by default (secure default, matching the
# RLS policies that only allow authenticated API access). Set to "false"
# only for local demos; anonymous visitors would otherwise see a
# dashboard whose every query fails.
VITE_REQUIRE_AUTH=true
