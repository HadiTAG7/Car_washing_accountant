# ═══════════════════════════════════════════════════════════════════════════
# Supabase configuration for Monster Wash
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to ".env.local" and fill in the values from
# your Supabase project: Project Settings → API
#
# If these are missing, the app still runs in DEMO MODE using seed data
# (useful for UI previews without a live database).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional — set to "true" to require login before showing the dashboard.
# Default: "false" (open access, useful for internal tools behind a VPN).
VITE_REQUIRE_AUTH=false
