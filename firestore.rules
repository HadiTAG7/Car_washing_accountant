rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// سويتر (Sweater) — Firestore security rules
// ═══════════════════════════════════════════════════════════════════════════
// Roles live on /users/{uid}.role:
//   admin      — full operational access, closes periods, manages accounts
//   accountant — posts and reverses entries, closes periods, reads everything
//   operator   — records day-to-day operations; cannot touch the ledger
//   partner    — read-only on operational data and reports
//
// Membership is /users/{uid}; /app_admins/{uid} additionally marks an admin.
// Legacy documents without a role are treated as `operator`, so an existing
// account keeps working after this file ships.
//
// THE LEDGER IS NOT CLIENT-WRITABLE.
//
// journal_entries, journal_lines, posting_locks, counters/journal,
// accounting_periods and audit_logs are READ-ONLY to every client, whatever
// its role. They are written exclusively by the callable Cloud Functions in
// functions/, which run with the Admin SDK.
//
// This is not belt-and-braces; it is the only way three of the invariants can
// exist at all. Firestore rules have no loop and no fold, so:
//   • "debits equal credits" over a list of unknown length is INEXPRESSIBLE —
//     a client could write Dr 100 / Cr 1 straight into the books;
//   • "this reversal names a real, balanced mirror entry" is likewise
//     inexpressible — `reversedBy` could point at nothing;
//   • "this lock is being released as part of a reversal" cannot be told
//     apart from "released so I can edit a posted record".
// A rule can only check shape. Accounting needs arithmetic, so it needs a
// trusted server.
//
// The client can NEVER write /app_admins either: privilege escalation would
// otherwise be one client-side write away.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── الهوية والأدوار ──────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function userDoc()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasUserDoc() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdminDoc() { return exists(/databases/$(database)/documents/app_admins/$(request.auth.uid)); }

    function role() {
      return hasUserDoc() && userDoc().keys().hasAny(['role'])
        ? userDoc().role
        : (isAdminDoc() ? 'admin' : 'operator');
    }
    function isAdmin()      { return signedIn() && (isAdminDoc() || role() == 'admin'); }
    function isAccountant() { return signedIn() && (isAdmin() || role() == 'accountant'); }
    function isOperator()   { return signedIn() && (isAccountant() || role() == 'operator'); }
    function isMember()     { return signedIn() && (hasUserDoc() || isAdminDoc()); }

    // A source record whose posting lock exists is IN THE BOOKS. The lock is
    // written by the posting transaction, so it is committed before any later
    // attempt to edit the record it protects.
    //
    // Locks are keyed on the record's KIND (`monthly__x`, `variable__x`, …).
    // They used to be keyed on the accounting source type, which put five
    // different expense collections in one `expense__x` namespace. Entries
    // posted before that change still carry the old id, so a record is only
    // free when NEITHER key exists — checking just one would leave every
    // expense posted since the change editable, or every expense posted
    // before it.
    function notLocked(kind, id) {
      return !exists(/databases/$(database)/documents/posting_locks/$(kind + '__' + id));
    }
    function notPosted(kind, id) {
      return notLocked(kind, id);
    }
    function notPostedExpense(kind, id) {
      return notLocked(kind, id) && notLocked('expense', id);
    }

    // ── دليل الحسابات ────────────────────────────────────────────────
    // Everyone who can see reports needs to resolve account names.
    match /chart_of_accounts/{code} {
      allow read:   if isMember();
      allow create, update: if isAccountant();
      // An unused account is deactivated (active:false), never deleted — a
      // deleted account would orphan every line that referenced it.
      allow delete: if false;
    }

    // ── دفاتر القيد المزدوج — للقراءة فقط من العميل ──────────────────
    // Written only by `ledgerPostEntry` / `ledgerReverseEntry`, which balance
    // the entry, derive its period from its date, mint the number atomically
    // and write the lock and the audit record in the same transaction.
    match /journal_entries/{entryId} {
      allow read:  if isMember();
      allow write: if false;
    }

    // Legacy collection: lines live inside their entry now. Readable so older
    // entries still render, frozen against every write.
    match /journal_lines/{lineId} {
      allow read:  if isMember();
      allow write: if false;
    }

    // ── أقفال الترحيل ────────────────────────────────────────────────
    // One document per operational record that reached the books. Created by
    // the posting function, deleted ONLY inside the reversal transaction —
    // which is why no client may touch them: a rule cannot tell a legitimate
    // release from one made to unlock an edit.
    match /posting_locks/{lockId} {
      allow read:  if isMember();
      allow write: if false;
    }

    // ── الفترات المحاسبية ────────────────────────────────────────────
    // Closing re-reads every entry in the month and re-checks that each one
    // balances on its own — arithmetic, so it belongs on the server.
    // `ledgerClosePeriod` does it; `ledgerReopenPeriod` requires an admin and
    // a written reason.
    match /accounting_periods/{periodKey} {
      allow read:  if isMember();
      allow write: if false;
    }

    // ── العدّادات ────────────────────────────────────────────────────
    // Every sequence — journal entries and tax documents alike — is minted
    // inside a server transaction. A client that could set a counter could
    // reissue a number that is already on a filed document.
    match /counters/{name} {
      allow read:  if isAccountant();
      allow write: if false;
    }

    // ── المستندات الضريبية ───────────────────────────────────────────
    // An issued invoice number is the identity a tax audit walks. It is never
    // deleted and never re-numbered; the only permitted amendment is marking
    // it cancelled, and the accounting effect of a cancellation still has to
    // come from a credit note.
    // Written only by `salesIssueDocument` / `salesVoidDocument`, which
    // recompute the totals from the lines and mint the number themselves. A
    // client that could name its own invoice number could reuse one, and a
    // duplicate number is the first thing a tax audit looks for.
    match /sales_documents/{docId} {
      allow read:  if isMember();
      allow write: if false;
    }

    // Idempotency claims: one source record → one document. A client that
    // could delete a claim could issue a second invoice for the same wash.
    match /sales_document_sources/{claimId} {
      allow read:  if isAccountant();
      allow write: if false;
    }

    // ── إعدادات التطبيق ──────────────────────────────────────────────
    // Deliberately NOT in the operational list below: `app_settings/company`
    // holds the VAT number that goes into every QR code. That is accounting
    // policy, not day-to-day data.
    //
    // `app_settings/accounting` is closed to clients ENTIRELY — readable,
    // never writable. It carries `taxPolicyHistory`, and a policy row decides
    // what every wash in a period means. Written from a browser it had three
    // holes: read-merge-write from two tabs drops a row with nothing to show
    // it existed, there was no audit record of a decision that restates
    // revenue, and nothing stopped a policy being back-dated into a month
    // already filed. It now goes through `accountingSetTaxPolicy`, which does
    // all three properly.
    // Rules are a permissive UNION: a second match that allows the write
    // would grant it however emphatically the first one denies. So the
    // exclusion lives on the wildcard itself rather than in a rule beside it.
    match /app_settings/{key} {
      allow read:  if isMember();
      allow write: if isAccountant() && key != 'accounting';
    }

    // ── سندات المصاريف المتكررة ──────────────────────────────────────
    // Generated from a monthly template, one per period. The document id is
    // `<templateId>__<periodKey>`, so re-generating overwrites rather than
    // duplicates. A voucher is cancelled, never deleted — the gap in a
    // monthly series is itself information.
    match /expense_vouchers/{voucherId} {
      allow read:   if isMember();
      allow create: if isAccountant();
      // A voucher carried into the books is frozen like any other posted
      // source: marking it paid or cancelling it after the fact would leave
      // the entry describing something the voucher no longer says. Reverse
      // the entry first — that releases the lock — then correct it.
      allow update: if isAccountant() && notPostedExpense('voucher', voucherId);
      allow delete: if false;
    }

    // ── سجل الأصول الثابتة ───────────────────────────────────────────
    // The register drives the depreciation entries, so it is an accountant's
    // record, not an operator's. An asset is deactivated or disposed of —
    // never deleted, or the entries that reference it would be orphaned.
    match /fixed_assets/{assetId} {
      allow read:   if isMember();
      allow create, update: if isAccountant();
      allow delete: if false;
    }

    // ── قواعد الرسوم ─────────────────────────────────────────────────
    match /fee_rules/{ruleId} {
      allow read:  if isMember();
      allow write: if isAdmin();
    }

    // ── سجل التدقيق ──────────────────────────────────────────────────
    // Written by the ledger functions only. A client that could append here
    // could fabricate the trail that is supposed to police it.
    match /audit_logs/{logId} {
      allow read:  if isAdmin() || isAccountant();
      allow write: if false;
    }

    // ── الحسابات والصلاحيات ──────────────────────────────────────────
    // A user reads their OWN record; only admins list users. Nobody edits
    // roles from the client — that is a console/server operation.
    match /users/{uid} {
      allow get:    if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName']);
      allow delete: if false;
    }

    // Privilege escalation guard: readable by admins for diagnostics,
    // writable by nobody through a client SDK.
    match /app_admins/{uid} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── المصادر المُرحّلة — محميّة على مستوى الخادم ──────────────────
    // Once a record is in the books, editing it would leave the operational
    // row and the immutable entry disagreeing, with nothing in the ledger to
    // show the change. The corrective path is a reversal or an adjusting
    // entry, never an edit — and that is enforced here rather than by a
    // warning in the UI, which a client can simply not render.
    //
    // The lock disappears when the entry is reversed, which is what makes a
    // legitimate correction possible: reverse, fix, re-post.
    match /washes/{id} {
      allow read:   if isMember();
      allow create: if isOperator();
      allow update, delete: if isOperator() && notPosted('wash', id);
    }
    match /partner_payments/{id} {
      allow read:   if isMember();
      allow create: if isOperator();
      allow update, delete: if isOperator() && notPosted('partner_payment', id);
    }
    match /monthly_expenses/{id} {
      allow read:   if isMember();
      allow create: if isOperator();
      allow update, delete: if isOperator() && notPostedExpense('monthly', id);
    }
    match /variable_expenses/{id} {
      allow read:   if isMember();
      allow create: if isOperator();
      allow update, delete: if isOperator() && notPostedExpense('variable', id);
    }
    match /annual_expense_entries/{id} {
      allow read:   if isMember();
      allow create: if isOperator();
      allow update, delete: if isOperator() && notPostedExpense('annual', id);
    }
    // ── سجل مصاريف بند التأسيس — للقراءة فقط من العميل ──────────────
    // Every entry here is a purchase document: it carries the spend date, the
    // payment method and the invoice identity that make it postable, and its
    // amount is summed into the parent's `actual_amount`. Three things a rule
    // cannot do, and all three are needed on every write:
    //
    //   • RE-SUM the siblings. A roll-up over a list of unknown length has no
    //     expression in rules — there is no fold — so `actual_amount` would be
    //     whatever the client last claimed it was.
    //   • Re-derive `status` from that sum against the budget.
    //   • Check the posting lock AND recompute the parent in ONE atomic step.
    //     A rule can see a lock; it cannot make the lock check and the parent
    //     update happen together, so a delete could clear an entry and leave
    //     the parent's total describing a row that no longer exists.
    //
    // So the client reads and the server writes: `startupAddEntry`,
    // `startupDeleteEntry` and `startupConvertLegacySpend` in functions/.
    match /startup_cost_entries/{id} {
      allow read:  if isMember();
      allow write: if false;
    }
    // An advance produces two entries — the outlay and its recovery — so both
    // locks have to be clear before the row may change.
    match /temporary_expenses/{id} {
      allow read:   if isMember();
      allow create: if isOperator();
      allow update, delete: if isOperator()
        && notPosted('temporary_expense', id) && notPosted('recovery', id);
    }

    // ── بنود رسوم التأسيس — خطة يكتبها العميل، وصرفٌ يكتبه الخادم ────
    // `startup_costs` used to sit in the operational wildcard, so an operator
    // could write EVERY field on it — including `actual_amount` and the whole
    // tax-invoice block. That is exactly the state the accounting fix removed
    // from the UI, and leaving it writable meant one direct write restored it:
    // a parent-level amount with an invoice on it enters the VAT report and
    // can never reach `1200`, because no adapter posts this collection and no
    // adapter can (the parent has no spend date, no payment method and no
    // per-document identity).
    //
    // Rules are a permissive UNION, so the exclusion had to come OFF the
    // wildcard list rather than be denied in a rule beside it — a second
    // matching `allow` would hand back everything this one withholds.
    //
    // What a client may write is the PLAN. What it may not write is anything
    // the ledger or the return reads.
    function startupPlanFields() {
      return ['category', 'item_name', 'quantity', 'budgeted_amount', 'status'];
    }
    // The columns the server owns. `actual_amount` is SUM(entries),
    // `converted_*` is the migration's own record, and the tax block belongs
    // to an entry that has a date to go with it.
    function startupServerFields() {
      return [
        'actual_amount', 'is_tax_invoice', 'invoice_number', 'invoice_date',
        'supplier', 'vat_amount', 'vat_rate', 'price_mode', 'vat_deductible',
        'invoice_url', 'converted_at', 'converted_by',
      ];
    }
    function startupCreateIsPlanOnly() {
      // A new item starts at zero with no document attached to it. Stated as
      // an explicit shape rather than an absence, so a client cannot create
      // the row and then "correct" it into a spend record.
      return request.resource.data.get('actual_amount', 0) == 0
        && request.resource.data.get('is_tax_invoice', false) == false
        && request.resource.data.get('invoice_number', null) == null
        && request.resource.data.get('invoice_date', null) == null
        && request.resource.data.get('supplier', null) == null
        && request.resource.data.get('vat_amount', null) == null
        && request.resource.data.get('vat_rate', null) == null
        && !request.resource.data.keys().hasAny(['converted_at', 'converted_by']);
    }
    function startupUpdateTouchesPlanOnly() {
      // `affectedKeys` is the diff, so an unchanged server column is fine —
      // what is refused is CHANGING one. `hasOnly` also rejects a field
      // nobody has heard of, which is how a new server-owned column would
      // otherwise arrive writable by default.
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(startupPlanFields())
        // Stated twice on purpose: `hasOnly` already excludes them, and this
        // says so by name, so adding a column to `startupPlanFields()` by
        // mistake cannot quietly open one of these.
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(startupServerFields());
    }
    match /startup_costs/{id} {
      allow read:   if isMember();
      allow create: if isOperator() && startupCreateIsPlanOnly();
      allow update: if isOperator() && startupUpdateTouchesPlanOnly();
      // Deleting a plan that has entries would orphan them; the sub-ledger is
      // emptied first, through the server.
      allow delete: if isOperator();
    }

    // ── البيانات التشغيلية ───────────────────────────────────────────
    // Members read; operators and above record day-to-day business.
    // These stay the operational source of truth — the reports read the
    // ledger, but the app still works from these collections.
    function isOperationalColl(c) {
      return c in [
        'annual_expense_categories', 'annual_expenses',
        'auth_users_backup', 'categories', 'category_budgets',
        'monthly_expense_categories', 'partners',
        'transactions', 'variable_expense_categories'
      ];
    }

    // NOTE: in Firestore every matching rule is evaluated and access is
    // granted if ANY allows, so a collection protected above must NOT also
    // appear in this list — the wildcard would hand back what the specific
    // rule denies.
    match /{coll}/{doc} {
      allow read:  if isOperationalColl(coll) && isMember();
      allow write: if isOperationalColl(coll) && isOperator();
    }
  }
}
