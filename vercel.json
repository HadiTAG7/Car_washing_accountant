{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["dub1"],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "functions": {
    "api/ledger.js": { "maxDuration": 60 },
    "api/integrations/sweater/operations.js": {
      "maxDuration": 60
    },
    "api/integrations/sweater/n8n.js": {
      "maxDuration": 60
    },
    "api/agent-command-center-ingest.js": {
      "maxDuration": 30
    },
    "api/agent-command-center-cleanup.js": {
      "maxDuration": 30
    },
    "api/password-reset.js": {
      "maxDuration": 30
    },
    "api/partner-mcp/[secret].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/operations-reports",
      "destination": "/api/ledger?operationsEndpoint=reports"
    },
    {
      "source": "/api/finance-reports",
      "destination": "/api/ledger?financeEndpoint=reports"
    },
    {
      "source": "/api/finance-workbench",
      "destination": "/api/ledger?financeEndpoint=workbench"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/agent-command-center-cleanup",
      "schedule": "15 1 * * *"
    }
  ]
}
