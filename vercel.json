{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/finance-reports.js": { "maxDuration": 60 },
    "api/finance-workbench.js": { "maxDuration": 60 },
    "api/integrations/sweater/operations.js": {
      "maxDuration": 60
    },
    "api/agent-command-center-ingest.js": {
      "maxDuration": 30
    },
    "api/agent-command-center-cleanup.js": {
      "maxDuration": 30
    },
    "api/password-reset.js": {
      "maxDuration": 30
    },
    "api/partner-mcp/[secret].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/agent-command-center-cleanup",
      "schedule": "15 1 * * *"
    }
  ]
}
